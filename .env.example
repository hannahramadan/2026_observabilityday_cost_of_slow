# Copy to .env (git-ignored) and fill in. Nothing here is a real secret.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-cheap-chat-model
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Export metrics every 5s instead of the 60s default, so the dashboard updates quickly.
OTEL_METRIC_EXPORT_INTERVAL=5000
